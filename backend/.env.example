# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pinnacle_db?schema=public

# Object Storage (S3 / MinIO Local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pinnacle-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Security & Secrets (Placeholders only)
JWT_SECRET=replace_with_a_secure_random_secret_in_development
JWT_EXPIRATION=7d

