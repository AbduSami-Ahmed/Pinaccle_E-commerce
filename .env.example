# ========================================================
# Pinnacle E-Commerce Monorepo Environment Variables Template
# Copy this file to .env or app-specific .env files.
# Never commit real credentials or production secrets to Git.
# ========================================================

# General Configuration
NODE_ENV=development

# API Backend Configuration
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pinnacle_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pinnacle_db
POSTGRES_PORT=5432

# Storefront Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Object Storage (Local MinIO S3 Placeholder)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pinnacle-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Security Secrets (Generate random 64-character strings for production)
JWT_SECRET=replace_with_a_secure_random_secret_in_development
JWT_EXPIRATION=7d

