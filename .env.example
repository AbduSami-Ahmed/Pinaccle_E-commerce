# ==============================================================================
# PINNACLE AUTO PARTS E-COMMERCE (NEW ZEALAND)
# Environment Variables & Secrets Reference Template
#
# ENVIRONMENT SEGREGATION:
# - DEVELOPMENT: Local machine, Docker Compose postgres, mock gateways enabled.
# - STAGING: AWS ECS Fargate (ap-southeast-2), RDS single-AZ, sandbox credentials.
# - PRODUCTION: AWS ECS Fargate (ap-southeast-2), RDS Multi-AZ, live credentials.
#
# SECURITY WARNING:
# Never commit actual values or production credentials to source control.
# In Staging & Production, secrets are injected dynamically via AWS Secrets Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development                    # 'development' | 'staging' | 'production'
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Regional & Financial Standards (New Zealand)
# ------------------------------------------------------------------------------
CURRENCY=NZD
TAX_RATE_PERCENT=15                     # New Zealand standard Goods & Services Tax (GST)
TIMEZONE=Pacific/Auckland

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL 16)
# Local: postgresql://postgres:postgres@localhost:5432/pinnacle_db?schema=public
# AWS RDS: Injected from AWS Secrets Manager ARN: arn:aws:secretsmanager:ap-southeast-2:...:secret:pinnacle/rds
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pinnacle_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pinnacle_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 4. Authentication & Encryption Security
# Generate high-entropy 64-character random hex strings: openssl rand -hex 32
# In Production: Injected from AWS Secrets Manager
# ------------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_min_32_characters_random_hex_for_local_testing_only
JWT_EXPIRATION=7d
ENCRYPTION_SECRET=dev_aes_gcm_256_bit_encryption_secret_minimum_32_characters

# ------------------------------------------------------------------------------
# 5. Object Storage (AWS S3 & CloudFront)
# Region: ap-southeast-2 (Sydney, Australia - low latency for NZ)
# ------------------------------------------------------------------------------
S3_REGION=ap-southeast-2
S3_BUCKET=pinnacle-storage-dev-apsoutheast2
S3_ENDPOINT=                            # Leave blank for native AWS S3; specify for local MinIO
S3_FORCE_PATH_STYLE=false               # true for MinIO, false for AWS S3
S3_ACCESS_KEY=                          # Injected via IAM Role / Instance Profile on AWS ECS
S3_SECRET_KEY=                          # Injected via IAM Role / Instance Profile on AWS ECS
CDN_BASE_URL=https://media.pinnacleparts.co.nz

# ------------------------------------------------------------------------------
# 6. Payment Processing (Stripe NZ & Mock Sandbox)
# ------------------------------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER=MOCK           # 'MOCK' in local dev/test; 'STRIPE' in staging/production
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_sandbox_checkout
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 7. Transactional Notifications (Email)
# ------------------------------------------------------------------------------
TRANSACTIONAL_EMAIL_PROVIDER=MOCK       # 'MOCK' in local dev; 'SMTP' (AWS SES) in staging/prod
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Pinnacle Auto Parts <orders@pinnacleparts.co.nz>"

# ------------------------------------------------------------------------------
# 8. External Vehicle & Marketplace Integrations (Optional / On-Demand)
# ------------------------------------------------------------------------------
# CarJam NZ Vehicle Plate Lookup
CARJAM_API_KEY=
CARJAM_ENDPOINT=https://test.carjam.co.nz/api/car/   # Test sandbox; production uses live api

# eBay Australia / Global Seller API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENVIRONMENT=SANDBOX                # 'SANDBOX' | 'PRODUCTION'

# Trade Me New Zealand In-Trade Seller API
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
TRADEME_OAUTH_TOKEN=
TRADEME_OAUTH_TOKEN_SECRET=
TRADEME_ENVIRONMENT=SANDBOX             # 'SANDBOX' | 'PRODUCTION'

# PartsTrader New Zealand B2B
PARTSTRADER_SUPPLIER_ID=
PARTSTRADER_API_KEY=
PARTSTRADER_ENVIRONMENT=SANDBOX

# CAP Ezi Vehicle Fitment
CAP_EZI_CLIENT_ID=
CAP_EZI_API_KEY=
CAP_EZI_ENVIRONMENT=SANDBOX

# Google Workspace / Gmail Business Mailbox
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 9. Next.js Storefront Public Environment Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Pinnacle Auto Parts NZ"
NEXT_PUBLIC_DEFAULT_CURRENCY=NZD
NEXT_PUBLIC_DEFAULT_COUNTRY=NZ
